{
  "$id": "billing-request-v1",
  "title": "Billing request (message body)",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "contractVersion", "operation", "idempotencyKey", "customerId", "callbackUrl", "payload"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "contractVersion": { "const": "1.0" },
    "operation": { "enum": ["STANDARD_INVOICE", "SERVICE_INVOICE"] },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9-]{8,64}$" },
    "customerId": { "type": "string", "pattern": "^C-\\d{4}$" },
    "callbackUrl": { "type": "string", "pattern": "^https?://\\S+$" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sku", "quantity"],
            "properties": {
              "sku": { "type": "string", "pattern": "^SKU-\\d{3}$" },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 9999 }
            }
          }
        }
      }
    }
  }
}
